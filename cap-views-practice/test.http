############################################################
# CAP CDS VIEWS PRACTICE
############################################################

@host = http://localhost:4004/odata/v4/views


############################################################
# 00. CREATE MASTER DATA
############################################################


### Create Customer 1
POST {{host}}/Customers
Content-Type: application/json

{
    "ID": 1,
    "name": "Rudra",
    "city": "Kolkata",
    "country": "India"
}


### Create Customer 2
POST {{host}}/Customers
Content-Type: application/json

{
    "ID": 2,
    "name": "Rahul",
    "city": "Delhi",
    "country": "India"
}


### Create Customer 3
POST {{host}}/Customers
Content-Type: application/json

{
    "ID": 3,
    "name": "Priya",
    "city": "Mumbai",
    "country": "India"
}


### Create Customer 4
POST {{host}}/Customers
Content-Type: application/json

{
    "ID": 4,
    "name": "John",
    "city": "New York",
    "country": "USA"
}



